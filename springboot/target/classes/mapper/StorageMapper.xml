<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.StorageMapper">

    <select id="selectAll" resultType="com.example.entity.Storage">
        select * from `storage`
        <where>
            <if test="name != null">name like concat('%', #{name}, '%')</if>
        </where>
    </select>

    <insert id="insert" parameterType="com.example.entity.Storage">
        insert into `storage` (name,remark)
        values (#{name}, #{remark})
    </insert>

    <update id="updateById" parameterType="com.example.entity.Storage">
        update `storage` set  name = #{name}, remark = #{remark}
        where id = #{id}
    </update>



</mapper>
