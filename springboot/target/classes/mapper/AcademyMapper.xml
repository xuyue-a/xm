<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.AcademyMapper">

    <select id="selectAll" resultType="com.example.entity.Academy">
        select * from `academy`
        <where>
            <if test="name != null">name like concat('%', #{name}, '%')</if>
        </where>
    </select>

    <insert id="insert" parameterType="com.example.entity.Academy">
        insert into `academy` (name)
        values (#{name})
    </insert>

    <update id="updateById" parameterType="com.example.entity.Academy">
        update `academy` set name = #{name}
        where id = #{id}
    </update>



</mapper>